{
  "name": "react-webpack-typescript-starter",
  "version": "0.1.0",
  "description": "Starter kit for React, Webpack (with Hot Module Replacement), Typescript.",
  "keywords": [
    "react",
    "webpack",
    "typescript",
    "sass",
    "hmr",
    "starter",
    "boilerplate"
  ],
  "author": "Viktor Persson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikpe/react-webpack-typescript-starter.git"
  },
  "sideEffects": "*.scss",
  "bugs": {
    "url": "https://github.com/vikpe/react-webpack-typescript-starter/issues"
  },
  "homepage": "https://github.com/vikpe/react-webpack-typescript-starter",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm clean-dist && webpack --config=configs/webpack/prod.js --progress",
    "clean-dist": "rimraf dist/*",
    "lint": "eslint './src/**/*.{js,ts,tsx}' --quiet",
    "start": "pnpm start-dev --progress",
    "start-dev": "webpack serve --config=configs/webpack/dev.js --port 3001",
    "start-prod": "pnpm build && node express.js",
    "test": "jest --coverage --watchAll --config=configs/jest.json"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "browserslist": "^4.28.7",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "express": "^5.2.1",
    "file-loader": "^6.2.0",
    "gametools-global-mapping": "^1.0.9",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "react-compiler-webpack": "^1.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.3",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@react-hook/window-size": "^3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "copy-webpack-plugin": "^14.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.2",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "regenerator-runtime": "^0.14.1",
    "workbox-webpack-plugin": "^7.4.1"
  }
}